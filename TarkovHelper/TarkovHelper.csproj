<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <EnableDefaultApplicationDefinition>false</EnableDefaultApplicationDefinition>

    <!-- App version. Still 4.3.1 (inherited); the first fork release retargets this
         to CalVer YYYY.M.N via /release. AssemblyVersion/FileVersion are intentionally
         omitted so the SDK derives both from Version — one knob the release can't leave
         half-bumped, and the value UpdateService reads at runtime. -->
    <Version>2026.7.0</Version>
    <ApplicationIcon>1764579946.ico</ApplicationIcon>

    <!-- App identity (fork of Zeliper/Tarkov-Item-Helper, maintained at josephjang/Tarkov-Item-Helper) -->
    <Product>Tarkov Item Helper</Product>
    <Authors>Zeliper, Jeongho Jang</Authors>
    <Copyright>Copyright (c) 2025 Zeliper, (c) 2026 Jeongho Jang</Copyright>
    <RepositoryUrl>https://github.com/josephjang/Tarkov-Item-Helper</RepositoryUrl>

    <!-- AutoUpdater.NET 다국어 리소스 제한 (en, ko, ja만 유지) -->
    <SatelliteResourceLanguages>en;ko;ja-jp</SatelliteResourceLanguages>

    <!-- Run as Administrator -->
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="1764579946.ico" />
  </ItemGroup>

  <ItemGroup>
    <!-- Embedded UI fonts, one entry per file (explicit so FontAssetsTests'
         csproj-vs-directory cross-check is meaningful) -->
    <Resource Include="Fonts\Bender-Regular.otf" />
    <Resource Include="Fonts\Bender-Bold.otf" />
    <Resource Include="Fonts\Play-Regular.ttf" />
    <Resource Include="Fonts\Play-Bold.ttf" />
    <Resource Include="Fonts\NotoSansCJKkr-Regular.otf" />
    <Resource Include="Fonts\NotoSansCJKkr-Bold.otf" />
    <!-- Font license texts must travel through publish into the release zip -->
    <None Update="Fonts\*.txt">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="Assets\Maps\*.svg">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="Assets\tarkov_data.db">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <!-- Local DB version stamp; without it a fresh install re-downloads the full DB on first check -->
    <None Update="Assets\db_version.txt">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="Assets\icons\*.png">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <Resource Include="Assets\DB\Icons\*.webp" />
    <None Update="Assets\DB\Icons\*.svg">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="Assets\DB\Icons\Markers\*.svg">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="Assets\DB\Maps\*.svg">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="Assets\DB\Data\*.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="TarkovHelper.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Autoupdater.NET.Official" Version="1.9.2" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="8.0.11" />
    <PackageReference Include="SharpVectors.Wpf" Version="1.8.5" />
    <PackageReference Include="Westermo.GraphX.Controls" Version="3.0.1" />
  </ItemGroup>

</Project>
