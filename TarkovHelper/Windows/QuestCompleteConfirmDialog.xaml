<Window x:Class="TarkovHelper.Windows.QuestCompleteConfirmDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Confirm Quest Completion"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        SizeToContent="WidthAndHeight"
        ShowInTaskbar="False">

    <Border Background="{DynamicResource BackgroundDarkBrush}"
            CornerRadius="8" Padding="24"
            MinWidth="480" MaxWidth="620" MaxHeight="650">
        <Border.Effect>
            <DropShadowEffect BlurRadius="20" ShadowDepth="0" Opacity="0.5"/>
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <Grid Grid.Row="0" Margin="0,0,0,12">
                <TextBlock x:Name="TxtCascadeTitle" Text="Confirm Quest Completion"
                           FontSize="{DynamicResource FontSizeXLarge}" FontWeight="SemiBold"
                           Foreground="{DynamicResource AccentBrush}"/>
                <Button x:Name="BtnCascadeClose" Content="X"
                        HorizontalAlignment="Right"
                        Padding="8,4" FontSize="{DynamicResource FontSizeSmall}"
                        Click="BtnCascadeDismiss_Click"/>
            </Grid>

            <!-- Clicked quest -->
            <TextBlock x:Name="TxtCascadeQuest" Grid.Row="1" Margin="0,0,0,12"
                       FontSize="{DynamicResource FontSizeSmall}"
                       Foreground="{DynamicResource TextPrimaryBrush}"
                       TextWrapping="Wrap"/>

            <!-- One outer ScrollViewer so the window's MaxHeight constraint reaches the
                 content: a bare StackPanel here would measure its children with infinite
                 height and silently clip the bottom (always the FAILED list) once the
                 sections outgrow the window — reachable at larger base font sizes. -->
            <ScrollViewer Grid.Row="2" Margin="0,0,0,16" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <!-- Prerequisites that will be auto-completed -->
                    <Border x:Name="CascadeCompletedSection"
                            Background="{DynamicResource BackgroundMediumBrush}"
                            CornerRadius="4" Margin="0,0,0,12">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <Border Grid.Row="0" Background="{DynamicResource BackgroundLightBrush}"
                                    CornerRadius="4,4,0,0" Padding="12,8">
                                <TextBlock x:Name="TxtCascadeCompletedHeader" Text="Will also be completed (0)"
                                           FontSize="{DynamicResource FontSizeSmall}" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextPrimaryBrush}"/>
                            </Border>
                            <ItemsControl Grid.Row="1" x:Name="CascadeCompletedList">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderThickness="0,0,0,1" BorderBrush="{DynamicResource BorderBrush}"
                                                Padding="12,6">
                                            <StackPanel>
                                                <TextBlock Text="{Binding QuestName}"
                                                           FontSize="{DynamicResource FontSizeXSmall}"
                                                           Foreground="{DynamicResource TextPrimaryBrush}"/>
                                                <TextBlock Text="{Binding Trader}"
                                                           FontSize="{DynamicResource FontSizeTiny}"
                                                           Foreground="{DynamicResource TextSecondaryBrush}"/>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Grid>
                    </Border>

                    <!-- Mutually exclusive alternatives that will be auto-failed; carries the
                         same AlternativeQuestBrush accent as the detail panel's
                         "Other Choices" section -->
                    <Border x:Name="CascadeFailedSection"
                            Background="{DynamicResource BackgroundMediumBrush}"
                            CornerRadius="4">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <Border Grid.Row="0" Background="{DynamicResource AlternativeQuestBackgroundBrush}"
                                    CornerRadius="4,4,0,0" Padding="12,8">
                                <TextBlock x:Name="TxtCascadeFailedHeader" Text="Will be FAILED (0)"
                                           FontSize="{DynamicResource FontSizeSmall}" FontWeight="SemiBold"
                                           Foreground="{DynamicResource AlternativeQuestBrush}"/>
                            </Border>
                            <TextBlock x:Name="TxtCascadeFailedNote" Grid.Row="1" Margin="12,8,12,0"
                                       FontSize="{DynamicResource FontSizeTiny}" FontStyle="Italic"
                                       Foreground="{DynamicResource AlternativeQuestBrush}" TextWrapping="Wrap"/>
                            <ItemsControl Grid.Row="2" x:Name="CascadeFailedList">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderThickness="0,0,0,1" BorderBrush="{DynamicResource BorderBrush}"
                                                Padding="12,6">
                                            <StackPanel>
                                                <TextBlock Text="{Binding QuestName}"
                                                           FontSize="{DynamicResource FontSizeXSmall}"
                                                           Foreground="{DynamicResource AlternativeQuestBrush}"/>
                                                <TextBlock Text="{Binding Trader}"
                                                           FontSize="{DynamicResource FontSizeTiny}"
                                                           Foreground="{DynamicResource TextSecondaryBrush}"/>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Grid>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- Action Buttons. IsCancel/IsDefault give the borderless modal its
                 keyboard path: Escape clicks Cancel, Enter clicks Confirm. -->
            <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="BtnCascadeCancel" Content="Cancel" IsCancel="True"
                        Padding="16,8" Margin="0,0,8,0"
                        Click="BtnCascadeDismiss_Click"/>
                <Button x:Name="BtnCascadeConfirm" Content="Complete Quest" IsDefault="True"
                        Padding="16,8"
                        Click="BtnCascadeConfirm_Click"
                        Background="{DynamicResource AccentBrush}"
                        Foreground="{DynamicResource BackgroundDarkBrush}"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
